# pnpm settings for this monorepo.
# Auto-install peers keeps multi-library workspaces from erroring on peer ranges;
# strict-peer-dependencies=false so a mismatched transitive peer is a warning, not a hard stop.
auto-install-peers=true
strict-peer-dependencies=false
# Keep the lockfile authoritative in CI.
prefer-frozen-lockfile=true
# Don't re-verify/install deps before every `pnpm run` — avoids blocking local
# script runs on pending build-script approvals (esbuild).
verify-deps-before-run=false
